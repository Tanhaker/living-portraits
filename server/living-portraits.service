[Unit]
Description=Living Portraits
After=network-online.target

[Service]
WorkingDirectory=/opt/lp/app/server
Environment=LP_ROOT=/opt/lp
Environment=LP_DATA=/opt/lp/data
Environment=HF_HOME=/opt/lp/cache/hf
ExecStart=/opt/lp/venv/bin/uvicorn app:app --host 0.0.0.0 --port 80
Restart=on-failure

[Install]
WantedBy=multi-user.target
